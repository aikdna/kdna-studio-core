.build/
DerivedData/
*.xcodeproj
xcuserdata/
Package.resolved
node_modules/

# The vendored offline dependency graph must travel with the repository so a
# clean clone installs these exact pinned KDNA/Read bytes; every other *.tgz
# stays ignored.
*.tgz
!vendor/*.tgz

# Internal Open-line evidence and progress material: kept in the working tree,
# not part of the public repository surface. One exception is retained and is
# intentionally published: `pr-3-acceptance.md` is a 9-line public-safe
# archival note that predates this boundary. Every other file here stays
# untracked.
docs/audits/*
!docs/audits/pr-3-acceptance.md

# Current public creation test artifacts
/test/.artifacts/
