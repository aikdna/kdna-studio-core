  "overrides": {
    "fast-uri": "3.1.7",
    "@aikdna/kdna-core": "$@aikdna/kdna-core",
    "@aikdna/kdna-read": "$@aikdna/kdna-read"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "require": "./src/index.js",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "private": true,
  "types": "src/index.d.ts"
}
